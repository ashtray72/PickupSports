# PickupSports Environment Configuration Template
# Copy this file to .env and configure your local keys:
#   cp .env.example .env
#
# DO NOT commit .env to GitHub (it is ignored by .gitignore).

# Google Places API Key (used for live nearby basketball court searches)
# If left blank or unset, the system automatically falls back to the Purdue campus mock dataset.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# PostgreSQL + PostGIS (started with `docker compose up -d db`).
# These defaults match docker-compose.yml and are for local development only.
DATABASE_URL=postgresql+asyncpg://pickup:pickup@localhost:5432/pickup
# Used by the pytest suite. Tests create, truncate and migrate this database freely.
TEST_DATABASE_URL=postgresql+asyncpg://pickup:pickup@localhost:5432/pickup_test

# Prototype sign-in for the API: trust the X-Dev-User header as the player's identity.
# Local development only. Never set this on a deployed server; anyone could pose as any user.
ALLOW_DEV_AUTH=1
