# Keep line endings consistent between Windows and macOS teammates.
# Text files are stored and checked out with LF; Git detects binaries automatically.
* text=auto eol=lf

# Windows-only scripts keep CRLF so PowerShell / cmd run them as expected.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch these.
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.pt binary
